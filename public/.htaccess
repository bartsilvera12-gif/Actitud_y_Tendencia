# Actitud & Tendencia — configuración para Hostinger (Apache / LiteSpeed).
# Este archivo vive en public/ y Vite lo copia a dist/ en cada build.

# ---------------------------------------------------------------------------
# Ruteo de la SPA
#
# El sitio es una sola página con rutas de React Router. Sin esto, entrar
# directo a /admin/login o /politicadeprivacidad —o recargar estando ahí—
# devuelve 404, porque en el servidor no existe ninguna carpeta con ese nombre.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el pedido es un archivo o una carpeta que existe de verdad, se sirve tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra cosa la resuelve React.
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Caché
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Los archivos de /assets/ llevan un hash en el nombre: si cambian, cambia el
  # nombre. Se pueden cachear para siempre sin riesgo de servir algo viejo.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Las fotos del repo conservan su nombre entre versiones, así que caché corta:
  # si se reemplaza una, se ve el cambio en poco tiempo.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # index.html nunca se cachea: es el que apunta al bundle nuevo. Si queda
  # cacheado, el navegador sigue pidiendo la versión anterior del sitio.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Compresión
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# No listar el contenido de las carpetas.
Options -Indexes
